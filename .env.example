# --- AI Gateway provider selection (see packages/ai-gateway) ---
# Each capability picks a provider by name. Swap to a paid provider later
# by changing one line here — no code changes.
AI_CHAT_PROVIDER=mock            # mock | llamacpp
AI_CHAT_PLANNER_PROVIDER=mock    # separate slot: frontier model for lesson planning later
AI_STT_PROVIDER=mock             # mock | whisper
AI_TTS_PROVIDER=mock             # mock | kokoro | piper
AI_VISION_PROVIDER=mock          # mock | llamacpp (multimodal)
AI_MODERATION_PROVIDER=rules     # rules (free, deterministic) | anthropic (rules + Claude classifier)
AI_PREMIUM_CHAT_PROVIDER=        # optional stronger brain for premium-plan sessions (e.g. llamacpp pointed at a bigger model, or a paid adapter)

# --- Admin (pre-billing): manually set account plans via POST /admin/plan ---
ADMIN_KEY=

# --- Web push notifications (npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tutor@yourdomain.com

# --- Optional: 5xx errors POSTed here (GlitchTip/Slack/Discord webhook) ---
ERROR_WEBHOOK_URL=

# --- Claude API (only used when AI_MODERATION_PROVIDER=anthropic) ---
# The one paid API on the platform: premium safety moderation for kids.
ANTHROPIC_API_KEY=
# Default claude-opus-5; claude-haiku-4-5 is the budget option for high volume.
ANTHROPIC_MODERATION_MODEL=

# --- Self-hosted inference endpoints (Contabo) ---
LLAMACPP_URL=http://localhost:8080          # llama.cpp server (--api) or vLLM OpenAI-compatible
WHISPER_URL=http://localhost:8081           # faster-whisper-server
# Kokoro serves the languages it covers; Piper covers the long tail.
# Set both and voices route themselves by id shape.
PIPER_TTS_URL=
TTS_URL=http://localhost:8082               # kokoro-fastapi or piper http wrapper
MATHCHECK_URL=http://localhost:8090         # services/mathcheck (FastAPI + SymPy)

# --- Data ---
DATABASE_URL=postgres://tutor:tutor@localhost:5432/tutor

# --- App ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Parent recap + verification emails via mailcow (unset = logged no-op) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Billing (Sprint 6b). Unset = billing endpoints return 501 and the
# upgrade buttons stay hidden; /admin/plan keeps working as the bridge.
# Pick ONE provider. Webhook URL to register with the provider:
#   https://<api-domain>/billing/webhook
BILLING_PROVIDER=                 # stripe | paystack (blank = off; "mock" is test-only)
# Stripe: create two recurring Prices, paste their price_... ids
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=            # from the webhook endpoint config (whsec_...)
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PREMIUM=
# Paystack: create two Plans, paste their PLN_... codes
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_PLUS=
PAYSTACK_PLAN_PREMIUM=

# --- Command Centre ---
# Emails that always hold the owner role. Comma separated. Set at least one or
# nobody can open the console. Everyone else is added from inside it.
COMMAND_OWNER_EMAILS=
# What a subscription actually costs per month, for the finance view. The
# processor holds the real prices; these are the numbers the console does its
# revenue maths with. Left blank, the console reports counts and says the
# prices are unset rather than showing an invented figure.
PRICE_PLUS_MONTHLY=
PRICE_PREMIUM_MONTHLY=
PRICE_CURRENCY=USD

# --- Tuning (all optional, sensible defaults shown) ---
# Requests per minute per IP across the API.
RATE_LIMIT_MAX=120
# Stricter cap on auth endpoints (login, register, forgot) per minute per IP.
AUTH_RATE_LIMIT=10
# Guest sessions allowed per IP per day before an account is required.
GUEST_IP_CAP=8
# Test-only billing webhook secret. Leave empty in production.
MOCK_BILLING_SECRET=
# Override provider API bases (testing only; empty means the real service).
STRIPE_API_BASE=
PAYSTACK_API_BASE=

# --- Web app (set on the WEB service, not the api) ---
# The api's public URL. Next.js bakes this in AT BUILD TIME, so it must be
# set before the web service builds, and a change needs a redeploy.
NEXT_PUBLIC_API_URL=
